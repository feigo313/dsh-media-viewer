{
  "name": "dsh-av-preview",
  "version": "0.1.1",
  "description": "Inline video/audio preview for the dsh-better-sidebar side card — a /media route with HTTP Range, so clips play and scrub without downloading first",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": {
      "default": "./client.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "test"
  ],
  "scripts": {
    "test": "node --test"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-better-sidebar",
    "video",
    "audio",
    "preview",
    "http-range"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/feigo313/dsh-av-preview.git"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  }
}
